name: nagadhat-v3 backend deployement

on:
  push:
    branches:
      - develop

jobs:
  deploy:
    runs-on: ubuntu-latest

    steps:
      - uses: actions/checkout@v2

      - name: Copy file via scp
        uses: appleboy/scp-action@master
        with:
          host: ${{ secrets.DEV_NAGADHAT_BACKEND_HOST }}
          username: ${{ secrets.DEV_NAGADHAT_BACKEND_USER }}
          port: ${{ secrets.DEV_NAGADHAT_BACKEND_PORT }}
          password: ${{ secrets.DEV_NAGADHAT_BACKEND_PASS }}
          source: "."
          target: ${{secrets.DEV_NAGADHAT_BACKEND_PATH}}

      - name: executing laravel deployement commands
        uses: appleboy/ssh-action@master
        with:
          host: ${{ secrets.DEV_NAGADHAT_BACKEND_HOST }}
          username: ${{ secrets.DEV_NAGADHAT_BACKEND_USER }}
          port: ${{ secrets.DEV_NAGADHAT_BACKEND_PORT }}
          password: ${{ secrets.DEV_NAGADHAT_BACKEND_PASS }}
          script: |
            # cd to App Path
            cd ${{secrets.DEV_NAGADHAT_BACKEND_PATH}}
            echo "creating env file...."
            php -r "file_exists('.env') || copy('.env.example', '.env');"
            echo "executing composer install...."
            composer install -q --no-ansi --no-interaction --no-scripts --no-progress --prefer-dist
            #echo "Generating key..."
            #php artisan key:generate
            echo "running migration"
            php artisan migrate
            #echo "run seed"
            #php artisan db:seed
            #echo "finally unit testing..."
            #vendor/bin/phpunit
            #echo "executing yarn command"
            #echo  yarn && yarn run prod
            echo "Cache clear..."
            php artisan cache:clear
            echo "Optimize clear..."
            php artisan optimize:clear
            echo "Granting directory permissions..."
            chmod -R 777 bootstrap/
            chmod -R 777 storage/
            chmod -R 777 public/
            echo "done...."



            
